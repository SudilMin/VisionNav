Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: 1 m Grid
      Reference Frame: base_footprint
      Cell Size: 1
      Plane Cell Count: 24
      Color: 110; 110; 110
      Alpha: 0.4
    - Class: rviz_default_plugins/LaserScan
      Enabled: false
      Name: LiDAR
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Alpha: 0.6
      Decay Time: 0
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Live Occupancy
      Topic:
        Value: /outdoor_occupancy
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Live Objects
      Topic:
        Value: /outdoor_markers
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Camera (adds Wi-Fi load)
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
      Transport Hint: compressed
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF
  Global Options:
    Fixed Frame: base_footprint
    Frame Rate: 30
    Background Color: 30; 30; 36
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Behind the wearer
      Target Frame: base_footprint
      Focal Point:
        X: 4
        Y: 0
        Z: 0
      Distance: 13
      Pitch: 0.75
      Yaw: 3.14159
Window Geometry:
  Height: 800
  Width: 1200
